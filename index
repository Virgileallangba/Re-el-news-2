function loadTimingCache(){try{return JSON.parse(localStorage.getItem(TIMING_CACHE_KEY)||'{}')}catch(e){return{}}}
function saveTimingCache(c){try{localStorage.setItem(TIMING_CACHE_KEY,JSON.stringify(c))}catch(e){}}
function recordGenerationTime(key,ms){
  const c=loadTimingCache();
  if(!c[key])c[key]=[];
  c[key].push(ms);
  if(c[key].length>10)c[key]=c[key].slice(-10);
  saveTimingCache(c);updateTimingDisplay();
}
function estimateGenerationTime(key,fallbackMs){
  const c=loadTimingCache();
  const s=c[key];
  if(s&&s.length>0){
    const sorted=[...s].sort((a,b)=>a-b);
    const mid=Math.floor(sorted.length/2);
    return sorted.length%2===0?(sorted[mid-1]+sorted[mid])/2:sorted[mid];
  }
  return fallbackMs;
}
function updateTimingDisplay(){
  const c=loadTimingCache();
  const v=c['video']||[];
  const s=document.getElementById('stat-speed');
  const t=document.getElementById('stat-samples');
  if(!s||!t)return;
  if(v.length===0){s.textContent='en attente';t.textContent='0 génération';return}
  const avg=v.reduce((a,b)=>a+b,0)/v.length;
  s.textContent=(avg/1000).toFixed(1)+' s en moyenne';
  t.textContent=v.length+' génération'+(v.length>1?'s':'');
}

/* ═══════════════════════════════════════════════════════════
   RSS
   ═══════════════════════════════════════════════════════════ */
async function fetchViaRss2Json(rssUrl){
  const apiKey=localStorage.getItem('rss2json_api_key')||'';
  const keyParam=apiKey?'&api_key='+encodeURIComponent(apiKey):'';
  const url='https://api.rss2json.com/v1/api.json?rss_url='+encodeURIComponent(rssUrl)+keyParam;
  const res=await fetch(url);
  if(!res.ok)throw new Error('HTTP '+res.status);
  const data=await res.json();
  if(data.status!=='ok')throw new Error('rss2json status: '+data.status);
  return(data.items||[]).map((item,i)=>({title:item.title||'',link:item.link||'',pubDate:item.pubDate||'',source:item.author||'Google News',rank:i+1}));
}
async function fetchViaAllOrigins(rssUrl){
  const url='https://api.allorigins.win/raw?url='+encodeURIComponent(rssUrl);
  const res=await fetch(url);
  if(!res.ok)throw new Error('HTTP '+res.status);
  return parseRssXml(await res.text());
}
async function fetchViaCodeTabs(rssUrl){
  const url='https://api.codetabs.com/v1/proxy/?quest='+encodeURIComponent(rssUrl);
  const res=await fetch(url);
  if(!res.ok)throw new Error('HTTP '+res.status);
  return parseRssXml(await res.text());
}
async function fetchViaThingProxy(rssUrl){
  const url='https://thingproxy.freeboard.io/fetch/'+rssUrl;
  const res=await fetch(url);
  if(!res.ok)throw new Error('HTTP '+res.status);
  return parseRssXml(await res.text());
}
function parseRssXml(text){
  const parser=new DOMParser();
  const xmlDoc=parser.parseFromString(text,'text/xml');
  const items=xmlDoc.querySelectorAll('item');
  const newsItems=[];
  items.forEach((item,i)=>{
    if(i>=25)return;
    const title=item.querySelector('title')?.textContent||'';
    const link=item.querySelector('link')?.textContent||'';
    const pubDate=item.querySelector('pubDate')?.textContent||'';
    const source=item.querySelector('source')?.textContent||'';
    if(title)newsItems.push({title,link,pubDate,source,rank:i+1});
  });
  return newsItems;
}
async function fetchGoogleNewsRSSWithFallback(category){
  const rssUrl=GOOGLE_NEWS_RSS[category]||GOOGLE_NEWS_RSS.ALL;
  const methods=[
    {name:'rss2json',fn:()=>fetchViaRss2Json(rssUrl)},
    {name:'allorigins',fn:()=>fetchViaAllOrigins(rssUrl)},
    {name:'codetabs',fn:()=>fetchViaCodeTabs(rssUrl)},
    {name:'thingproxy',fn:()=>fetchViaThingProxy(rssUrl)}
  ];
  for(const method of methods){
    try{
      debugLog('info','RSS','Tentative '+method.name+'…');
      const items=await method.fn();
      if(items&&items.length>0){
        debugLog('success','RSS',method.name+' → '+items.length+' actualités');
        return{items,method:method.name};
      }
