function debugLog(level,category,message,data){
  const body=document.getElementById('debug-body');
  if(!body)return;
  const time=new Date().toLocaleTimeString('fr-FR',{hour12:false});
  const entry=document.createElement('div');
  entry.className='debug-entry '+level;
  let html='<span class="debug-time">'+time+'</span>';
  html+='<span class="debug-cat">['+esc(category)+']</span>';
  html+='<span class="debug-msg">'+esc(message)+'</span>';
  if(data!==undefined&&data!==null){
    let dataStr;
    if(typeof data==='string')dataStr=data;
    else{try{dataStr=JSON.stringify(data,null,2)}catch(e){dataStr=String(data)}}
    if(dataStr.length>3000)dataStr=dataStr.slice(0,3000)+'\n…[tronqué]';
    html+='<pre class="debug-data">'+esc(dataStr)+'</pre>';
  }
  entry.innerHTML=html;
  body.appendChild(entry);
  debugEntries.push({time,level,category,message});
  if(debugEntries.length>DEBUG_MAX_ENTRIES)debugEntries.shift();
  while(body.children.length>DEBUG_MAX_ENTRIES)body.removeChild(body.firstChild);
  body.scrollTop=body.scrollHeight;
  debugCount++;
  const countEl=document.getElementById('debug-count');
  if(countEl)countEl.textContent=debugCount;
}
function clearDebug(){const body=document.getElementById('debug-body');if(body)body.innerHTML='';debugEntries=[];debugCount=0;const el=document.getElementById('debug-count');if(el)el.textContent='0';debugLog('info','SYSTEM','Console effacée')}
function copyDebug(){
  const lines=debugEntries.map(e=>e.time+' ['+e.category+'] '+e.message).join('\n');
  const finish=(ok)=>showToast(ok?'Console copiée':'Copie impossible',ok?'success':'error');
  try{
    if(navigator.clipboard&&window.isSecureContext){
      navigator.clipboard.writeText(lines).then(()=>finish(true)).catch(()=>legacyCopy(lines,finish));
      return;
    }
  }catch(e){}
  legacyCopy(lines,finish);
}
function legacyCopy(text,cb){
  const ta=document.createElement('textarea');
  ta.value=text;ta.style.position='fixed';ta.style.top='0';ta.style.left='0';
  ta.style.width='2em';ta.style.height='2em';ta.style.padding='0';
  ta.style.border='none';ta.style.outline='none';ta.style.boxShadow='none';
  ta.style.background='transparent';ta.style.opacity='0';
  document.body.appendChild(ta);ta.focus();ta.select();ta.setSelectionRange(0,text.length);
  let ok=false;try{ok=document.execCommand('copy')}catch(e){ok=false}
  document.body.removeChild(ta);cb(ok);
}
