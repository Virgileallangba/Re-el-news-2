async function retryTask(name,fn,maxAttempts=3){
  let lastError=null;
  for(let i=1;i<=maxAttempts;i++){
    if(state.stopRequested)throw new Error('Arrêt demandé');
    try{
      debugLog('info','RETRY',name+' — essai '+i+'/'+maxAttempts);
      return await fn();
    }catch(e){
      lastError=e;
      if(e.message==='Arrêt demandé')throw e;
      if(/abandon|indisponible|saturée en continu/i.test(e.message))throw e;
      debugLog('warn','RETRY',name+' échoué : '+e.message);
      if(i<maxAttempts){
        const wait=Math.min(90,8*i*i);
        setStatus(name+' — reprise automatique dans '+wait+'s');
        await sleep(wait*1000);
      }
    }
  }
  throw lastError||new Error(name+' échoué');
}

