   ═══════════════════════════════════════════════════════════ */
function renderJT(){
  const panel=document.getElementById('jt-panel');
  const card=document.getElementById('jt-card');
  if(!panel||!card||!state.jt)return;
  const jt=state.jt;
  let html='';
  html+='<div class="jt-title">'+esc(jt.jt_title||'Le JT du Jour J')+'</div>';
  const metaParts=[jt.segments.length+' sujets', DIRECTORS[state.director].label, PALETTES[state.palette].label];
  if(state.seriesMode)metaParts.unshift(getDayName()+' · MODE SÉRIE');
  html+='<div class="jt-meta">'+esc(metaParts.join(' · '))+'</div>';
  html+='<div style="text-align:center;margin-bottom:1rem;"><span class="host-tag">🎙️ <strong>'+esc(jt.host.name)+'</strong> — '+esc((jt.host.description||'').slice(0,90))+'</span></div>';
  jt.segments.forEach((s,i)=>{
    html+='<div class="seg-block" data-seg="'+i+'">';
    html+='<div class="seg-num">Sujet '+(i+1)+' / '+jt.segments.length+' — '+esc(s.emotion||'')+'</div>';
    html+='<div class="seg-headline">'+esc(s.headline)+'</div>';
    html+='<div class="seg-summary">'+esc(s.summary)+'</div>';
    if(s.host_dialogue)html+='<div class="seg-dialogue"><span class="spk">🎙️ '+esc(jt.host.name)+' (plateau)</span>« '+esc(s.host_dialogue)+' »</div>';
    if(s.host_action)html+='<div class="seg-action">🎬 Plateau hook : '+esc(s.host_action.slice(0,180))+(s.host_action.length>180?'…':'')+'</div>';
    if(s.people&&s.people.length>0){
      html+='<div class="seg-cast">👥 Casting : '+s.people.map(p=>'<strong>'+esc(p.name)+'</strong> ('+esc(p.role)+')').join(' · ')+'</div>';
    }
    if(s.reporter){
      html+='<div class="seg-dialogue"><span class="spk">📍 '+esc(s.reporter.name)+' (sur place)</span>« '+esc(s.reporter.dialogue)+' »</div>';
      if(s.scene_action)html+='<div class="seg-action">🎬 Reporter hook : '+esc(s.scene_action.slice(0,200))+(s.scene_action.length>200?'…':'')+'</div>';
      html+='<div class="seg-loc">📍 '+esc((s.location||'').slice(0,160))+'</div>';
      if(s.camera_plan)html+='<div class="seg-action">📷 Caméra : '+esc(s.camera_plan.slice(0,140))+(s.camera_plan.length>140?'…':'')+'</div>';
    }
    html+='</div>';
  });
  card.innerHTML=html;
  panel.classList.add('visible');
}

function renderImagesGrid(){
  const grid=document.getElementById('images-grid');
  if(!grid||!state.jt)return;
  let html='';
  if(state.hostImage)html+='<div class="image-card host"><img src="'+state.hostImage+'" alt=""><div class="img-label">🎙️ Roger Blip</div></div>';
  else html+='<div class="image-card loading host">Plateau…</div>';
  state.jt.segments.forEach((s,i)=>{
    const img=state.sceneImages['reporter-'+i];
    if(img&&img.url)html+='<div class="image-card reporter"><img src="'+img.url+'" alt=""><div class="img-label">📍 '+esc(s.reporter.name)+'</div></div>';
    else html+='<div class="image-card loading reporter">Reporter '+(i+1)+'…</div>';
  });
  grid.innerHTML=html;
}
function updateHostImageCard(url){
  const el=document.querySelector('.image-card.host');
  if(!el)return;
  el.classList.remove('loading');
  el.innerHTML='<img src="'+url+'" alt=""><div class="img-label">🎙️ Roger Blip</div>';
}
function updateReporterImageCard(index,url,name){
  const cards=document.querySelectorAll('.image-card.reporter');
  const el=cards[index];
  if(!el)return;
  el.classList.remove('loading');
  el.innerHTML='<img src="'+url+'" alt=""><div class="img-label">📍 '+esc(name)+'</div>';
}

function renderQueue(){
  const queueEl=document.getElementById('queue');
  if(!queueEl)return;
  if(!state.videos.length){queueEl.style.display='none';return}
  const total=state.videos.length;
  const done=state.videos.filter(v=>v.status==='done').length;
  const failed=state.videos.filter(v=>v.status==='failed').length;
  const inProg=state.videos.filter(v=>v.status==='processing'||v.status==='creating').length;
  const pending=total-done-failed-inProg;
  const est=estimateGenerationTime('video',30000+state.durationSeconds*5000)/1000;
  const eta=pending>0?(pending*(createVideoIntervalMs/1000))+est:0;
  let summary=queueEl.querySelector('.queue-summary');
  const summaryHtml='<span class="qs-progress">VIDÉOS : '+done+'/'+total+'</span>'
    +(failed>0?'<span style="color:var(--err);">'+failed+' échec'+(failed>1?'s':'')+'</span>':'')
    +'<span class="qs-eta">'+(done+failed<total?'≈ '+formatEta(eta)+' restant':'Terminé')+'</span>';
  if(!summary){
    summary=document.createElement('div');
    summary.className='queue-summary';
    queueEl.insertBefore(summary,queueEl.firstChild);
  }
  if(summary.dataset.sig!==summaryHtml){
    summary.innerHTML=summaryHtml;
    summary.dataset.sig=summaryHtml;
  }
  state.videos.forEach((item,i)=>{
    let el=queueEl.querySelector('.queue-item[data-idx="'+i+'"]');
    if(!el){
      el=document.createElement('div');
      el.className='queue-item pending';
      el.dataset.idx=i;
      el.innerHTML='<div class="q-icon">○</div><div class="q-name">'+esc(item.label)+'</div><div class="q-status">En file</div>';
      queueEl.appendChild(el);
    }
    let icon='○',statusText='En file',cls='pending';
    if(item.status==='creating'){icon='◐';statusText='Préparation…';cls='creating'}
    else if(item.status==='processing'){icon='◐';statusText=item.progress||'En cours…';cls='processing'}
    else if(item.status==='done'){icon='●';statusText='Terminé';cls='done'}
    else if(item.status==='failed'){icon='✕';statusText='Échec';cls='failed'}
    const sig=cls+'|'+icon+'|'+statusText;
    if(el.dataset.sig!==sig){
      el.className='queue-item '+cls;
      el.querySelector('.q-icon').textContent=icon;
      el.querySelector('.q-status').textContent=statusText;
      el.dataset.sig=sig;
    }
  });
  queueEl.style.display='block';
}
function markSeg(segIndex,status){
  const el=document.querySelector('.seg-block[data-seg="'+segIndex+'"]');
  if(!el)return;
  el.classList.remove('active','done');
  if(status)el.classList.add(status);
}

function ensureJTGallerySkeleton(){
  const galleryEl=document.getElementById('gallery');
  const grid=document.getElementById('gallery-grid');
  if(!galleryEl||!grid||!state.jt)return;
  if(grid.dataset.built==='1')return;
  grid.innerHTML='';
  state.jt.segments.forEach((s,i)=>{
    const seg=document.createElement('div');
    seg.className='jt-segment';
    seg.dataset.seg=i;
    const castLine=(s.people||[]).map(p=>p.name+' ('+p.role+')').join(' · ');
    seg.innerHTML='<div class="jt-segment-info"><div class="jt-seg-headline">📰 '+esc(s.headline)+'</div><div class="jt-seg-summary">'+esc(s.summary)+'</div>'+(castLine?'<div class="seg-cast">👥 '+esc(castLine)+'</div>':'')+'</div><div class="jt-segment-videos"><div class="jt-video host" data-video="host-'+i+'"><div class="jt-video-placeholder">🎙️ Roger Blip — en attente…</div><div class="jt-video-label"><span class="who">🎙️ '+esc(state.jt.host.name)+'</span><span class="loc">Plateau</span></div></div><div class="jt-video reporter" data-video="reporter-'+i+'"><div class="jt-video-placeholder">📍 Sur place — en attente…</div><div class="jt-video-label"><span class="who">📍 '+esc(s.reporter.name)+'</span><span class="loc">'+esc((s.location||'').slice(0,40))+'</span></div></div></div>';
    grid.appendChild(seg);
  });
  grid.dataset.built='1';
  galleryEl.style.display='block';
}
function setJTVideo(videoKey,url){
  const el=document.querySelector('.jt-video[data-video="'+videoKey+'"]');
  if(!el)return;
  const placeholder=el.querySelector('.jt-video-placeholder');
  if(placeholder)placeholder.remove();
  const existing=el.querySelector('video');
  if(existing)existing.remove();
  const v=document.createElement('video');
  v.controls=true;
  v.preload='metadata';
  v.playsInline=true;
  v.src=url;
  el.insertBefore(v,el.firstChild);
}

function addMediaLogEntry(kind,url){
  const log=document.getElementById('media-log');
  if(!log)return;
  const empty=log.querySelector('div[style]');
  if(empty)empty.remove();
  const time=new Date().toLocaleTimeString('fr-FR',{hour12:false});
  const el=document.createElement('div');
  el.className='media-log-entry';
  const displayUrl=url.length>120?url.slice(0,120)+'…':url;
  el.innerHTML='<span style="font-size:.58rem;padding:.15rem .4rem;border-radius:2px;text-transform:uppercase;font-weight:700;background:rgba(232,123,53,.15);color:var(--acc2);">'+kind+'</span><span style="flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;color:var(--acc);font-size:.66rem;"><a href="'+esc(url)+'" target="_blank" rel="noopener" style="color:var(--acc);text-decoration:none;">'+esc(displayUrl)+'</a></span><span style="color:var(--faint);font-size:.62rem;">'+time+'</span>';
  log.appendChild(el);
  const countEl=document.getElementById('medialog-count');
  if(countEl)countEl.textContent=String(log.querySelectorAll('.media-log-entry').length);
}

/* ═══════════════════════════════════════════════════════════
   PIPELINE ÉPISODE
   ═══════════════════════════════════════════════════════════ */
async function startJT(){
  if(state.isRunning)return;
  if(!getApiKey()){showToast('Ajoutez votre clé API','error');document.getElementById('api-key-input').focus();return}
  state.isRunning=true;
  state.stopRequested=false;
  state.jt=null;
  state.rawScenarioResponse='';
  state.hostImage=null;
  state.sceneImages={};
  state.videos=[];
  document.getElementById('jt-card').innerHTML='';
  document.getElementById('jt-panel').classList.remove('visible');
  document.getElementById('images-grid').innerHTML='';
  document.getElementById('queue').innerHTML='';
  document.getElementById('queue').style.display='none';
  document.getElementById('raw-scenario').textContent='';
  document.getElementById('media-log').innerHTML='<div style="font-size:.72rem;color:var(--dim);font-family:var(--fm);">Les URLs apparaîtront ici.</div>';
  document.getElementById('medialog-count').textContent='0';
  document.getElementById('gallery-grid').innerHTML='';
  document.getElementById('gallery-grid').dataset.built='0';
  document.getElementById('gallery').style.display='none';
  document.getElementById('stop-btn').classList.add('visible');
  document.getElementById('jt-btn').disabled=true;
  document.getElementById('phase-bar').classList.add('visible');

  // ═══════════════════════════════════════════════════════════
  // MODE SÉRIE — Application des réglages fixes
  // ═══════════════════════════════════════════════════════════
  if(state.seriesMode && SERIES.enabled){
    state.director = SERIES.director;
    state.palette = SERIES.palette;
    state.durationSeconds = SERIES.duration;
    state.segCount = SERIES.segCount;

    // Sync des contrôles UI
    const dirSel=document.getElementById('director-select');
    if(dirSel)dirSel.value = SERIES.director;
    const durSel=document.getElementById('duration-select');
    if(durSel)durSel.value = String(SERIES.duration);
    const segSel=document.getElementById('seg-count-select');
    if(segSel)segSel.value = String(SERIES.segCount);
    document.querySelectorAll('.palette-btn').forEach(b=>{
      b.classList.toggle('active', b.dataset.palette === SERIES.palette);
    });
    debugLog('success','SÉRIE','Mode série actif — Roger Blip / Wes Anderson / Corail-Cyan / 3 infos');
  }

  await ensureWakeLockActive();
  const totalStart=Date.now();
  const globalTimeoutCheck=setInterval(()=>{
    if(state.isRunning&&Date.now()-totalStart>JT_GLOBAL_TIMEOUT_MS){
      debugLog('error','TIMEOUT','Épisode dépassé 30 minutes — arrêt forcé');
      state.stopRequested=true;
      setStatus('Délai global dépassé (30 min) — arrêt en cours');
      clearInterval(globalTimeoutCheck);
    }
  },30000);
  debugLog('state','START','════════════════════════════════════════');
  debugLog('state','START','DÉMARRAGE DE L\'ÉPISODE — '+(state.seriesMode?getTodayEpisodeLabel():'mode libre'));
  debugLog('state','CONFIG','Jour : '+getDayName());
  debugLog('state','CONFIG','Sujets : '+state.segCount);
  debugLog('state','CONFIG','Réalisateur : '+DIRECTORS[state.director].label);
  debugLog('state','CONFIG','Palette : '+PALETTES[state.palette].label);
  debugLog('state','CONFIG','Durée : '+state.durationSeconds+'s · Résolution : '+state.resolution);
  debugLog('state','CONFIG','Mode série : '+(state.seriesMode?'ON (Roger Blip)':'OFF'));
  debugLog('state','CONFIG','Références : '+state.referenceImages.length+' · Rôle : '+state.refRole);
  try{
    setPhase('text','📡 Récupération des actualités…','');
    setStatus('Chargement des Google News…');

    // Choix de la catégorie : auto en mode série, manuel sinon
    let category;
    if(state.seriesMode && SERIES.enabled){
      category = getCategoryForToday();
      debugLog('info','SÉRIE','Catégorie auto pour '+getDayName()+' : '+category);
    }else{
      category = document.getElementById('news-category').value;
    }

    const newsResult=await fetchGoogleNewsRSSWithFallback(category);
    state.newsItems=newsResult.items;
    state.newsMethod=newsResult.method;
    renderNewsList();
    document.getElementById('news-status').textContent=newsResult.items.length+' actualités chargées ('+(newsResult.method==='demo'?'mode démo':'via '+newsResult.method)+').';
    debugLog('success','NEWS',newsResult.items.length+' items via '+newsResult.method);

    let refDescriptions=[];
    if(state.referenceImages.length>0){
      setPhase('text','🖼️ Analyse des références personnages…','');
      refDescriptions=await describeReferenceImages();
      debugLog('success','REF',refDescriptions.length+' référence(s) décrite(s)');
    }
    const hostRefBlock=buildReferenceBlock(refDescriptions,state.refRole==='auto'?'host':state.refRole);
    const reporterRefBlock=buildReferenceBlock(refDescriptions,state.refRole==='auto'?'reporters':state.refRole);
    const castRefBlock=buildReferenceBlock(refDescriptions,'all');

    setPhase('text','🧠 Génération du scénario — '+(state.seriesMode?getTodayEpisodeLabel():'épisode')+'…','');
    const jt=await generateJTScenario(state.newsItems,state.segCount,state.director,state.palette,castRefBlock);
    state.jt=jt;
    state.segCount=jt.segments.length;
    renderJT();
    ensureJTGallerySkeleton();
    renderImagesGrid();
    state.videos=[];
    jt.segments.forEach((s,i)=>{
      state.videos.push({key:'host-'+i,label:'🎙️ Roger Blip — sujet '+(i+1),status:'pending',progress:null,videoId:null,videoUrl:null,startTime:null});
      state.videos.push({key:'reporter-'+i,label:'📍 '+s.reporter.name+' + casting — sujet '+(i+1),status:'pending',progress:null,videoId:null,videoUrl:null,startTime:null});
    });
    renderQueue();

    setPhase('images','🎨 Création de Roger Blip…','');
    setStatus('Création de l\'image de Roger Blip…');
    const hostPrompt=buildHostImagePrompt(jt.host,state.director,state.palette,hostRefBlock);
    try{
      const hostUrl=await generateImage(hostPrompt);
      state.hostImage=hostUrl;
      updateHostImageCard(hostUrl);
      addMediaLogEntry('image',hostUrl);
      debugLog('success','HOST','Image Roger Blip OK');
    }catch(e){debugLog('warn','HOST','Échec : '+e.message)}

    setPhase('images','🎨 Création des '+state.segCount+' équipes sur place…','');
    const imageQueue=createRateLimitedQueue(IMAGE_PARALLEL,IMAGE_INTERVAL_MS);
    const reporterTasks=[];
    for(let i=0;i<jt.segments.length;i++){
      const idx=i;
      const seg=jt.segments[idx];
      const prompt=buildReporterImagePrompt(seg,state.director,state.palette,reporterRefBlock);
      reporterTasks.push(imageQueue.add(async()=>{
        if(state.stopRequested)return;
        try{
          const url=await generateImage(prompt);
          state.sceneImages['reporter-'+idx]={url,name:seg.reporter.name};
          updateReporterImageCard(idx,url,seg.reporter.name);
          addMediaLogEntry('image',url);
          debugLog('success','REPORTER '+(idx+1),'OK');
        }catch(e){
          if(e.message==='Arrêt demandé')return;
          debugLog('error','REPORTER '+(idx+1),e.message);
        }
      }));
    }
    await Promise.allSettled(reporterTasks);
    await imageQueue.idle();

    setPhase('videos','🎬 Génération des '+state.videos.length+' vidéos hook…','');
    createVideoIntervalMs=VIDEO_INTERVAL_SAFE;
    videoAttemptsSinceLastError=0;
    const pollingTasks=[];
    for(let i=0;i<state.videos.length;i++){
      if(state.stopRequested)break;
      const item=state.videos[i];
      const isHost=item.key.startsWith('host-');
      const segIdx=parseInt(item.key.split('-')[1],10);
      const seg=jt.segments[segIdx];
      const imageUrl=isHost?state.hostImage:(state.sceneImages['reporter-'+segIdx]&&state.sceneImages['reporter-'+segIdx].url);
      if(!imageUrl){item.status='failed';item.progress='Image manquante';renderQueue();continue}
      item.status='creating';
      item.progress='Préparation…';
      renderQueue();
      markSeg(segIdx,'active');
      setPhase('videos','🎬 '+(isHost?'Roger Blip':'Reporter')+' — sujet '+(segIdx+1)+' / '+jt.segments.length,'≈ '+formatEta((state.videos.length-i)*(createVideoIntervalMs/1000+60))+' restant');
      try{
        const prompt=isHost
          ?buildHostVideoPrompt(jt,seg,state.director,state.palette,hostRefBlock)
          :buildReporterVideoPrompt(jt,seg,state.director,state.palette,reporterRefBlock);
        const videoId=await generateVideo(imageUrl,imageUrl,prompt);
        item.videoId=videoId;
        item.startTime=Date.now();
        item.status='processing';
        item.progress='En cours…';
        renderQueue();
        debugLog('success',item.key,'Tâche : '+videoId);
        pollingTasks.push((async()=>{
          try{
            const videoUrl=await pollVideo(videoId,(prog)=>{item.progress=prog;renderQueue()});
            const elapsed=Date.now()-item.startTime;
            recordGenerationTime('video',elapsed);
            item.status='done';
            item.videoUrl=videoUrl;
            item.progress='Terminé';
            renderQueue();
            setJTVideo(item.key,videoUrl);
            addMediaLogEntry('video',videoUrl);
            if(!isHost)markSeg(segIdx,'done');
            debugLog('success',item.key,'Terminé en '+(elapsed/1000).toFixed(1)+'s');
          }catch(e){
            if(e.message==='Arrêt demandé'){item.status='failed';item.progress='Arrêté'}
            else{item.status='failed';item.progress='Échec';debugLog('error',item.key,e.message)}
            renderQueue();
          }
        })());
      }catch(e){
        if(e.message==='Arrêt demandé')break;
        item.status='failed';
        item.progress='Échec';
        if(/abandon|indisponible|saturée en continu/i.test(e.message)){
          debugLog('error',item.key,'Abandon : '+e.message);
          showToast('Queue vidéo saturée — abandon de la génération','error',6000);
          state.stopRequested=true;
        }else{
          debugLog('error',item.key,e.message);
        }
        renderQueue();
      }
      if(i<state.videos.length-1&&!state.stopRequested){
        let waitSec=Math.ceil(createVideoIntervalMs/1000);
        for(let r=waitSec;r>0;r--){
          if(state.stopRequested)break;
          setPhase('videos','🌬️ Respiration — prochaine vidéo dans '+r+'s','≈ '+formatEta((state.videos.length-i-1)*(createVideoIntervalMs/1000+60))+' restant');
          await sleep(1000);
        }
      }
    }
    if(pollingTasks.length>0){
      setPhase('videos','🎞️ Finalisation…','');
      await Promise.allSettled(pollingTasks);
    }
    setPhase('done','✦ Épisode prêt ✦','');
  }catch(e){
    debugLog('error','GLOBAL',e.message);
    if(/abandon|indisponible|saturée en continu/i.test(e.message)){
      showToast('Queue vidéo Agnes saturée — réessayez dans 30 min','error',8000);
    }
  }
  clearInterval(globalTimeoutCheck);
  const totalElapsed=(Date.now()-totalStart)/1000;
  const doneV=state.videos.filter(v=>v.status==='done').length;
  const totalV=state.videos.length;
  const summary=state.stopRequested?'Arrêté — '+doneV+'/'+totalV+' vidéos':'✦ Épisode prêt — '+doneV+'/'+totalV+' vidéos en '+formatEta(totalElapsed)+' ✦';
  debugLog('state','FIN',summary);
  debugLog('state','FIN','════════════════════════════════════════');
  setStatus(summary);
  await sleep(4500);
  setStatus(null);
  state.isRunning=false;
  state.stopRequested=false;
  document.getElementById('stop-btn').classList.remove('visible');
  updateJTButton();
  if(doneV>0)showToast('Épisode prêt · '+doneV+' vidéo'+(doneV>1?'s':'')+' générée'+(doneV>1?'s':''),'success',4000);
  else showToast('Aucune vidéo générée','error',3500);
  await deactivateWakeLock();
}

/* ═══════════════════════════════════════════════════════════
   INITIALISATION
   ═══════════════════════════════════════════════════════════ */
(function init(){
  storageAvailable=testStorageAvailable();

  const saveBtn=document.getElementById('api-save-btn');
  if(saveBtn)saveBtn.addEventListener('click',saveApiKey);

  const apiInput=document.getElementById('api-key-input');
  if(apiInput){
    apiInput.addEventListener('keydown',(e)=>{
      if(e.key==='Enter'){e.preventDefault();saveApiKey()}
    });
  }

  const stopBtn=document.getElementById('stop-btn');
  if(stopBtn){
    stopBtn.addEventListener('click',()=>{
      state.stopRequested=true;
      debugLog('warn','STOP','Arrêt demandé');
      setStatus('Arrêt en cours…');
    });
  }

  document.querySelectorAll('[data-toggle]').forEach(header=>{
    header.addEventListener('click',()=>{
      const target=document.getElementById(header.dataset.toggle);
      if(target)target.classList.toggle('open');
    });
  });

  // ═══ Toggle MODE SÉRIE ═══
  const seriesToggle=document.getElementById('series-mode-toggle');
  const seriesCheckbox=document.getElementById('series-mode-checkbox');
  if(seriesCheckbox){
    seriesCheckbox.addEventListener('change',e=>{
      state.seriesMode=e.target.checked;
      if(seriesToggle)seriesToggle.classList.toggle('active',e.target.checked);
      const hint=document.getElementById('category-hint');
      if(hint){
        hint.textContent = e.target.checked
          ? 'En mode série, la catégorie est choisie automatiquement selon le jour : '+getDayName()+' → '+getCategoryForToday()
          : 'Sélectionnez manuellement la catégorie des news.';
      }
      const label=document.getElementById('series-mode-label');
      if(label){
        label.textContent = e.target.checked ? 'MODE SÉRIE ACTIF · Roger Blip' : 'MODE LIBRE';
      }
      debugLog('state','SÉRIE','Mode '+(e.target.checked?'activé':'désactivé'));
      updateJTButton();
    });
  }

  const segSelect=document.getElementById('seg-count-select');
  if(segSelect)segSelect.addEventListener('change',e=>{state.segCount=parseInt(e.target.value,10);updateJTButton()});
  const durationSelect=document.getElementById('duration-select');
  if(durationSelect)durationSelect.addEventListener('change',e=>{state.durationSeconds=parseInt(e.target.value,10);updateJTButton()});
  const resolutionSelect=document.getElementById('resolution-select');
  if(resolutionSelect)resolutionSelect.addEventListener('change',e=>{state.resolution=e.target.value;updateJTButton()});
  const intensitySelect=document.getElementById('intensity-select');
  if(intensitySelect)intensitySelect.addEventListener('change',e=>{state.intensity=e.target.value});
  const directorSelect=document.getElementById('director-select');
  if(directorSelect)directorSelect.addEventListener('change',e=>{state.director=e.target.value;updateJTButton()});

  document.querySelectorAll('.palette-btn').forEach(btn=>{
    btn.addEventListener('click',()=>{
      document.querySelectorAll('.palette-btn').forEach(b=>b.classList.remove('active'));
      btn.classList.add('active');
      state.palette=btn.dataset.palette;
      updateJTButton();
    });
  });

  const jtBtn=document.getElementById('jt-btn');
  if(jtBtn)jtBtn.addEventListener('click',startJT);

  const debugHeader=document.getElementById('debug-header');
  if(debugHeader){
    debugHeader.addEventListener('click',(e)=>{
      if(e.target.tagName==='BUTTON')return;
      toggleDebugCollapse();
    });
  }
  const debugCollapseBtn=document.getElementById('debug-collapse-btn');
  if(debugCollapseBtn)debugCollapseBtn.addEventListener('click',(e)=>{e.stopPropagation();toggleDebugCollapse()});
  const debugClearBtn=document.getElementById('debug-clear-btn');
  if(debugClearBtn)debugClearBtn.addEventListener('click',(e)=>{e.stopPropagation();clearDebug()});
  const debugCopyBtn=document.getElementById('debug-copy-btn');
  if(debugCopyBtn)debugCopyBtn.addEventListener('click',(e)=>{e.stopPropagation();copyDebug()});

  const rawToggle=document.getElementById('raw-scenario-toggle');
  if(rawToggle){
    rawToggle.addEventListener('click',()=>{
      const el=document.getElementById('raw-scenario');
      if(!el)return;
      el.style.display=el.style.display==='none'?'block':'none';
      rawToggle.textContent=el.style.display==='none'?'▸ Voir la réponse brute du scénario (JSON)':'▾ Masquer';
    });
  }

  const refZone=document.getElementById('ref-upload-zone');
  const refInput=document.getElementById('ref-file-input');
  if(refZone&&refInput){
    refZone.addEventListener('click',()=>refInput.click());
    refInput.addEventListener('change',e=>{addReferenceImages(e.target.files);e.target.value=''});
    ['dragenter','dragover'].forEach(ev=>refZone.addEventListener(ev,e=>{e.preventDefault();refZone.classList.add('dragover')}));
    ['dragleave','drop'].forEach(ev=>refZone.addEventListener(ev,e=>{e.preventDefault();refZone.classList.remove('dragover')}));
    refZone.addEventListener('drop',e=>{
      if(e.dataTransfer&&e.dataTransfer.files)addReferenceImages(e.dataTransfer.files);
    });
  }
  const refRoleSelect=document.getElementById('ref-role-select');
  if(refRoleSelect){
    refRoleSelect.addEventListener('change',e=>{
      state.refRole=e.target.value;
      debugLog('state','REF','Rôle : '+e.target.value);
    });
  }
  renderRefGallery();

  const savedKey=getApiKey();
  if(savedKey){
    memoryApiKey=savedKey;
    const inp=document.getElementById('api-key-input');
    if(inp)inp.value=savedKey;
  }

  updateApiPanel();
  updateTimingDisplay();
  renderNewsList();

  // Mise à jour du hint de catégorie en fonction du jour
  const catHint=document.getElementById('category-hint');
  if(catHint){
    catHint.textContent='Mode série : la catégorie est choisie automatiquement selon le jour. Aujourd\'hui ('+getDayName()+') → '+getCategoryForToday();
  }

  debugLog('success','INIT','NewsReel Studio — Le JT du Jour J prêt');
  debugLog('success','SÉRIE','Épisode du jour : '+getTodayEpisodeLabel()+' ('+getDayName()+')');
  debugLog('success','SÉRIE','Chroniqueur fixe : Roger Blip');
  debugLog('success','SÉRIE','Catégorie auto : '+getCategoryForToday());
  debugLog(storageAvailable?'success':'warn','INIT','Stockage : '+(storageAvailable?'localStorage OK (clé persistante)':'mémoire uniquement (localStorage bloqué)'));
  debugLog('info','INIT','Modèles : '+MODEL_TEXT+' / '+MODEL_IMAGE+' / '+MODEL_VIDEO);
  debugLog('info','INIT','Réalisateurs : '+Object.keys(DIRECTORS).length+' styles');
  debugLog('info','INIT','Palettes : '+Object.keys(PALETTES).length+' palettes');
  debugLog('info','INIT','Catégories news : '+Object.keys(GOOGLE_NEWS_RSS).length+' flux RSS');
  debugLog('info','INIT','Références personnages : max '+REF_MAX_IMAGES+' images, 3 Mo chacune');
})();
</script>
</body>
</html>
