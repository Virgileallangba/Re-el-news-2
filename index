<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
<title>NewsReel Studio — Le JT du Jour J</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;-webkit-tap-highlight-color:transparent}
:root{
--bg:#0a0a12;--bg2:#12121c;--bg3:#1a1a28;
--panel:#16161f;--border:#2a2a3a;
--ink:#e8e6e0;--dim:#8a8896;--faint:#4a4858;
--acc:#e5c15a;--acc2:#e87b35;
--ok:#4a9d6a;--err:#c85a4a;--warn:#d4a017;
--r:4px;--fs:-apple-system,BlinkMacSystemFont,'Helvetica Neue',Arial,sans-serif;
--fm:ui-monospace,'SF Mono',Menlo,monospace;
}
html,body{background:var(--bg)}
body{font-family:var(--fs);background:var(--bg);color:var(--ink);min-height:100vh;padding:1.5rem 1rem 24rem;font-size:15px;line-height:1.55;max-width:900px;margin:0 auto}
header{margin-bottom:2rem;text-align:center;padding:1rem 0 1.5rem;position:relative}
header::after{content:'';position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:120px;height:1px;background:linear-gradient(90deg,transparent,var(--acc),transparent);opacity:.5}
h1{font-size:2rem;font-weight:300;margin-bottom:.5rem;background:linear-gradient(135deg,var(--acc2),var(--acc));-webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent}
.subtitle{font-size:.9rem;color:var(--dim);font-style:italic}
.toast{position:fixed;top:1.5rem;left:50%;transform:translateX(-50%) translateY(-120px);background:var(--bg3);color:var(--ink);border:1px solid var(--border);border-left:3px solid var(--acc);padding:.85rem 1.4rem;border-radius:var(--r);font-size:.85rem;box-shadow:0 8px 32px rgba(0,0,0,.6);z-index:1000;opacity:0;transition:transform .35s cubic-bezier(.2,.9,.3,1.2),opacity .35s;max-width:90vw;text-align:center;display:flex;align-items:center;gap:.6rem}
.toast.visible{transform:translateX(-50%) translateY(0);opacity:1}
.toast.success{border-left-color:var(--ok)}.toast.error{border-left-color:var(--err)}.toast.warn{border-left-color:var(--warn)}
.banner{background:var(--panel);border:1px solid var(--border);border-left:2px solid var(--acc);padding:1rem 1.15rem;border-radius:var(--r);font-size:.8rem;color:var(--dim);margin-bottom:1.2rem;line-height:1.6}
.banner strong{color:var(--ink)}.banner .hl{color:var(--acc)}
.series-badge{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1rem;background:linear-gradient(135deg,rgba(232,123,53,.15),rgba(229,193,90,.1));border:1px solid var(--acc);border-radius:999px;font-size:.78rem;font-weight:600;color:var(--acc);margin-bottom:1rem}
.series-badge .dot-live{width:6px;height:6px;border-radius:50%;background:var(--err);box-shadow:0 0 8px var(--err);animation:pulse 1.5s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.panel{background:var(--panel);border:1px solid var(--border);border-radius:var(--r);padding:1.2rem 1.3rem;margin-bottom:1rem}
.panel.ok{box-shadow:inset 3px 0 0 var(--ok)}
input[type=password],input[type=text]{width:100%;padding:.85rem 1rem;border-radius:var(--r);border:1px solid var(--border);background:var(--bg2);color:var(--ink);font-family:var(--fm);font-size:.82rem;margin-bottom:.6rem}
input:focus{outline:none;border-color:var(--acc)}
.btn{width:100%;padding:.85rem 1.2rem;border-radius:var(--r);border:1px solid var(--border);background:var(--bg2);color:var(--ink);font-size:.85rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;cursor:pointer;margin-bottom:.7rem;transition:background .2s}
.btn:hover{background:var(--bg3)}
.btn-primary{border-color:var(--acc);background:linear-gradient(135deg,rgba(232,123,53,.2),rgba(229,193,90,.15));color:var(--acc);font-size:1rem;padding:1.2rem;letter-spacing:.2em}
.btn-primary:disabled{opacity:.3;cursor:not-allowed}
.btn-stop{border-color:var(--err);color:var(--err);background:transparent;display:none}
.btn-stop.visible{display:block}
.status{font-size:.75rem;padding:.6rem .9rem;border-radius:var(--r);margin-bottom:.5rem;display:flex;align-items:center;gap:.6rem;background:var(--bg2);color:var(--dim);border:1px solid var(--border)}
.status.ok{background:rgba(74,157,106,.08);color:var(--ok);border-color:rgba(74,157,106,.3)}
.status.warn{background:rgba(212,160,23,.08);color:var(--warn);border-color:rgba(212,160,23,.3)}
.dot{width:6px;height:6px;border-radius:50%;background:var(--faint);flex-shrink:0}
.status.ok .dot{background:var(--ok);box-shadow:0 0 8px var(--ok)}
.status.warn .dot{background:var(--warn);box-shadow:0 0 8px var(--warn)}
.hint{font-size:.72rem;color:var(--dim);margin-top:.5rem}
.hint a{color:var(--acc);text-decoration:none}
.stat{font-size:.72rem;color:var(--dim);margin-top:.6rem;padding:.5rem .7rem;background:var(--bg2);border-radius:var(--r);display:flex;justify-content:space-between;flex-wrap:wrap;gap:.3rem;border:1px solid var(--border);font-family:var(--fm)}
.section{background:var(--panel);border:1px solid var(--border);border-radius:var(--r);margin-bottom:1rem;overflow:hidden}
.section-header{padding:1rem 1.2rem;cursor:pointer;user-select:none;display:flex;justify-content:space-between;align-items:center}
.section-title{font-size:.85rem;text-transform:uppercase;letter-spacing:.2em;color:var(--ink);font-weight:500;display:flex;align-items:center;gap:.6rem}
.badge{display:inline-block;padding:.15rem .55rem;background:transparent;color:var(--acc);border:1px solid var(--border);border-radius:2px;font-size:.6rem;letter-spacing:.15em;font-weight:600}
.badge.series{background:rgba(232,123,53,.15);border-color:var(--acc2);color:var(--acc2)}
.chevron{font-size:.7rem;color:var(--faint);transition:transform .3s}
.section.open .chevron{transform:rotate(180deg);color:var(--acc)}
.section-body{max-height:0;overflow:hidden;transition:max-height .4s ease}
.section.open .section-body{max-height:8000px}
.section-content{padding:0 1.2rem 1.2rem}
.row{margin-bottom:1rem}
.label{display:block;font-size:.72rem;color:var(--dim);margin-bottom:.5rem;text-transform:uppercase;letter-spacing:.15em;font-weight:600}
select{width:100%;padding:.8rem .95rem;border-radius:var(--r);border:1px solid var(--border);background:var(--bg2);color:var(--ink);font-size:.88rem;appearance:none;background-image:url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='10' height='6' viewBox='0 0 10 6'><path fill='%23e5c15a' d='M0 0l5 6 5-6z'/></svg>");background-repeat:no-repeat;background-position:right .95rem center;background-size:10px}
select:focus{outline:none;border-color:var(--acc)}
select option{background:var(--bg2);color:var(--ink)}
.palette-row{display:flex;gap:.5rem;flex-wrap:wrap}
.palette-btn{flex:1;min-width:100px;padding:.7rem .5rem;border-radius:var(--r);border:1px solid var(--border);background:var(--bg2);color:var(--dim);font-size:.7rem;font-weight:600;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;transition:all .2s;text-align:center}
.palette-btn:hover{border-color:var(--faint);color:var(--ink)}
.palette-btn.active{border-color:var(--acc);color:var(--acc);background:rgba(229,193,90,.06)}
.news-list{max-height:300px;overflow-y:auto;border:1px solid var(--border);border-radius:var(--r);background:var(--bg2)}
.news-item{padding:.7rem .9rem;border-bottom:1px solid var(--border);font-size:.8rem;display:flex;gap:.6rem;align-items:flex-start}
.news-item:last-child{border-bottom:none}
.news-rank{font-family:var(--fm);font-size:.65rem;color:var(--acc);font-weight:700;flex-shrink:0;min-width:20px}
.news-title{color:var(--ink);line-height:1.4}
.news-source{font-size:.65rem;color:var(--faint);margin-top:.2rem}
.phase-bar{background:var(--panel);border:1px solid var(--border);border-left:2px solid var(--acc);border-radius:var(--r);padding:.9rem 1rem;margin-bottom:1rem;display:none}
.phase-bar.visible{display:block}
.phase-steps{display:flex;gap:.4rem;margin-bottom:.7rem;flex-wrap:wrap}
.phase-step{flex:1;min-width:60px;padding:.5rem .4rem;border-radius:var(--r);background:var(--bg2);border:1px solid var(--border);font-size:.55rem;text-transform:uppercase;letter-spacing:.06em;text-align:center;color:var(--faint);font-weight:600}
.phase-step.active{color:var(--acc);border-color:var(--acc);background:rgba(229,193,90,.06)}
.phase-step.done{color:var(--ok);border-color:rgba(74,157,106,.3);background:rgba(74,157,106,.05)}
.phase-info{font-size:.75rem;font-family:var(--fm);color:var(--dim);display:flex;justify-content:space-between;flex-wrap:wrap;gap:.4rem}
.queue{margin-top:1.2rem}
.queue-summary{background:var(--panel);border:1px solid var(--border);border-left:2px solid var(--acc);border-radius:var(--r);padding:.8rem 1rem;margin-bottom:.7rem;font-size:.78rem;display:flex;justify-content:space-between;flex-wrap:wrap;gap:.5rem;font-family:var(--fm)}
.qs-progress{color:var(--acc);font-weight:600}
.qs-eta{color:var(--dim)}
.queue-item{display:flex;align-items:center;gap:.8rem;padding:.75rem .9rem;border-radius:var(--r);border:1px solid var(--border);margin-bottom:.4rem;background:var(--panel);font-size:.82rem}
.queue-item.pending{opacity:.45}
.queue-item.creating{border-color:var(--warn);background:linear-gradient(90deg,rgba(212,160,23,.05),var(--panel))}
.queue-item.processing{border-color:var(--acc);background:linear-gradient(90deg,rgba(74,123,200,.06),var(--panel))}
.queue-item.done{border-color:var(--ok);background:linear-gradient(90deg,rgba(74,157,106,.05),var(--panel))}
.queue-item.failed{border-color:var(--err);background:linear-gradient(90deg,rgba(200,90,74,.05),var(--panel))}
.q-icon{font-size:1rem;width:1.5rem;text-align:center;flex-shrink:0}
.q-name{flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.q-status{font-size:.7rem;color:var(--dim);text-align:right;max-width:55%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;font-family:var(--fm)}
.jt-panel{display:none;margin-top:1.5rem}
.jt-panel.visible{display:block}
.jt-card{background:var(--panel);border:1px solid var(--border);border-radius:var(--r);padding:1.2rem 1.3rem;margin-bottom:1rem}
.jt-title{font-size:1.4rem;color:var(--acc);margin-bottom:.4rem;text-align:center}
.jt-meta{font-size:.7rem;color:var(--dim);text-align:center;letter-spacing:.15em;text-transform:uppercase;margin-bottom:1.2rem;font-family:var(--fm)}
.host-tag{display:inline-flex;align-items:center;gap:.4rem;font-size:.72rem;padding:.35rem .8rem;border-radius:999px;background:rgba(200,176,224,.1);border:1px solid var(--acc);color:var(--ink);margin:0 auto 1rem}
.seg-block{border-left:2px solid var(--border);padding-left:1rem;margin-bottom:1.2rem}
.seg-block.active{border-left-color:var(--acc)}
.seg-block.done{border-left-color:var(--ok)}
.seg-num{font-size:.62rem;letter-spacing:.2em;text-transform:uppercase;color:var(--faint);font-family:var(--fm);margin-bottom:.3rem}
.seg-headline{font-size:1rem;color:var(--acc);line-height:1.35;margin-bottom:.4rem}
.seg-summary{font-size:.78rem;color:var(--ink);background:rgba(229,193,90,.05);border-left:2px solid var(--acc);padding:.5rem .7rem;border-radius:2px;margin-bottom:.5rem;line-height:1.5}
.seg-cast{font-size:.7rem;color:var(--ink);margin-top:.3rem;padding:.35rem .6rem;background:rgba(168,216,200,.06);border-left:2px solid var(--ok);border-radius:2px}
.seg-dialogue{font-size:.88rem;font-style:italic;color:var(--ink);line-height:1.5;padding:.35rem .6rem;margin:.3rem 0}
.seg-dialogue .spk{font-size:.6rem;text-transform:uppercase;letter-spacing:.15em;color:var(--acc);font-style:normal;font-weight:600;display:block;margin-bottom:.15rem}
.seg-action{font-size:.7rem;color:var(--acc2);margin-top:.3rem;padding:.3rem .5rem;background:rgba(232,123,53,.06);border-left:2px solid var(--acc2);border-radius:2px}
.seg-loc{font-size:.7rem;color:var(--ok);margin-top:.3rem}
.gallery{margin-top:1.8rem}
.gallery-title{font-size:1.1rem;color:var(--ink);margin-bottom:1rem;letter-spacing:.15em;text-transform:uppercase;text-align:center;padding-bottom:.8rem;position:relative}
.gallery-title::after{content:'';position:absolute;bottom:0;left:50%;transform:translateX(-50%);width:60px;height:1px;background:linear-gradient(90deg,transparent,var(--acc),transparent)}
.jt-segment{margin-bottom:2rem;border:1px solid var(--border);border-radius:var(--r);overflow:hidden;background:var(--panel)}
.jt-segment-info{padding:1rem 1.1rem;background:rgba(229,193,90,.04);border-bottom:1px solid var(--border)}
.jt-seg-headline{font-size:1rem;color:var(--acc);line-height:1.35;margin-bottom:.4rem}
.jt-seg-summary{font-size:.78rem;color:var(--ink);line-height:1.5}
.jt-segment-videos{display:grid;grid-template-columns:1fr 1fr;gap:.6rem;padding:.8rem}
@media(max-width:480px){.jt-segment-videos{grid-template-columns:1fr}}
.jt-video{border-radius:var(--r);overflow:hidden;border:1px solid var(--border);background:#000}
.jt-video video{width:100%;display:block;aspect-ratio:9/16;object-fit:cover;background:#000}
.jt-video-label{padding:.5rem .6rem;background:var(--bg2);font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;font-family:var(--fm);display:flex;justify-content:space-between;gap:.4rem}
.jt-video.host .jt-video-label{color:var(--acc)}
.jt-video.reporter .jt-video-label{color:var(--ok)}
.jt-video-placeholder{display:flex;align-items:center;justify-content:center;aspect-ratio:9/16;color:var(--faint);font-size:.7rem;font-family:var(--fm);background:var(--bg2);border:1px dashed var(--border)}
.images-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(90px,1fr));gap:.6rem;margin-top:1.2rem}
.image-card{border-radius:var(--r);overflow:hidden;border:1px solid var(--border);background:var(--bg2);position:relative;aspect-ratio:9/16}
.image-card.loading{display:flex;align-items:center;justify-content:center;color:var(--faint);font-size:.65rem;font-family:var(--fm)}
.image-card img{width:100%;height:100%;object-fit:cover;display:block}
.img-label{position:absolute;bottom:0;left:0;right:0;padding:.3rem .5rem;background:linear-gradient(transparent,rgba(10,10,18,.9));font-size:.6rem;font-family:var(--fm);color:var(--acc);letter-spacing:.1em;text-transform:uppercase}
.image-card.host .img-label{color:var(--acc)}
.image-card.reporter .img-label{color:var(--ok)}
.status-bar{position:fixed;bottom:0;left:0;right:0;background:var(--bg3);border-top:1px solid var(--border);color:var(--ink);padding:.85rem 1.1rem;font-size:.78rem;display:flex;align-items:center;gap:.7rem;transform:translateY(100%);transition:transform .35s cubic-bezier(.2,.9,.3,1);z-index:100;font-family:var(--fm);box-shadow:0 -4px 20px rgba(0,0,0,.4)}
.status-bar.visible{transform:translateY(0)}
.spinner{width:12px;height:12px;border:2px solid rgba(229,193,90,.2);border-top-color:var(--acc);border-radius:50%;animation:spin .8s linear infinite;flex-shrink:0}
@keyframes spin{to{transform:rotate(360deg)}}
.debug-panel{position:fixed;bottom:0;left:0;right:0;height:260px;background:#05050a;border-top:2px solid var(--acc);z-index:200;display:flex;flex-direction:column;font-family:var(--fm);box-shadow:0 -8px 32px rgba(0,0,0,.7);transition:height .3s ease}
.debug-panel.collapsed{height:36px}
.debug-header{display:flex;justify-content:space-between;align-items:center;padding:.5rem .8rem;background:linear-gradient(90deg,#0f0f18,#1a1a28);border-bottom:1px solid var(--border);flex-shrink:0;cursor:pointer;user-select:none}
.debug-title{font-size:.72rem;color:var(--acc);letter-spacing:.15em;text-transform:uppercase;font-weight:600;display:flex;align-items:center;gap:.5rem}
.debug-badge{font-size:.6rem;padding:.1rem .4rem;background:var(--acc);color:var(--bg);border-radius:2px;font-weight:700}
.debug-actions{display:flex;gap:.3rem}
.debug-actions button{background:transparent;border:1px solid var(--border);color:var(--dim);font-size:.62rem;padding:.25rem .55rem;border-radius:2px;cursor:pointer}
.debug-actions button:hover{color:var(--acc);border-color:var(--acc)}
.debug-body{flex:1;overflow-y:auto;padding:.5rem .7rem 1rem;font-size:.72rem;line-height:1.45;color:#c8c8d0}
.debug-entry{margin-bottom:.3rem;padding:.25rem .4rem;border-left:2px solid transparent;border-radius:2px;word-break:break-word}
.debug-entry.info{border-left-color:var(--faint)}
.debug-entry.success{border-left-color:var(--ok);background:rgba(74,157,106,.04)}
.debug-entry.warn{border-left-color:var(--warn);background:rgba(212,160,23,.04)}
.debug-entry.error{border-left-color:var(--err);background:rgba(200,90,74,.06);color:#f0a0a0}
.debug-entry.api{border-left-color:var(--acc)}
.debug-entry.response{border-left-color:var(--acc2)}
.debug-entry.state{border-left-color:var(--acc2)}
.debug-entry.ai{border-left-color:var(--acc)}
.debug-time{color:var(--faint);margin-right:.5rem;font-size:.65rem}
.debug-cat{color:var(--acc);font-weight:600;margin-right:.4rem;font-size:.65rem}
.debug-msg{color:#d8d8e0}
.debug-data{margin-top:.3rem;padding:.4rem .5rem;background:#0a0a12;border:1px solid var(--border);border-radius:2px;font-size:.68rem;color:#a8d8b0;max-height:180px;overflow:auto;white-space:pre-wrap;word-break:break-all;line-height:1.4}
.media-log-entry{display:flex;align-items:center;gap:.5rem;padding:.4rem .5rem;border-bottom:1px solid var(--border);font-family:var(--fm)}
.media-log-entry:last-child{border-bottom:none}
.hidden{display:none!important}
.ref-thumb{position:relative;aspect-ratio:1;border-radius:var(--r);overflow:hidden;border:1px solid var(--border);background:var(--bg2)}
.ref-thumb img{width:100%;height:100%;object-fit:cover;display:block}
.ref-thumb .ref-del{position:absolute;top:.2rem;right:.2rem;width:1.4rem;height:1.4rem;border-radius:50%;background:rgba(200,90,74,.9);color:#fff;border:none;font-size:.7rem;cursor:pointer;display:flex;align-items:center;justify-content:center;font-weight:700}
.ref-thumb .ref-badge{position:absolute;bottom:0;left:0;right:0;padding:.25rem .4rem;background:linear-gradient(transparent,rgba(10,10,18,.9));font-size:.55rem;font-family:var(--fm);color:var(--acc);text-transform:uppercase;letter-spacing:.08em}
#ref-upload-zone.dragover{border-color:var(--acc);background:rgba(229,193,90,.04)}
.series-toggle{display:flex;align-items:center;gap:.7rem;padding:.75rem 1rem;background:var(--bg2);border:1px solid var(--border);border-radius:var(--r);margin-bottom:1rem;cursor:pointer}
.series-toggle input{width:auto;margin:0}
.series-toggle-label{flex:1;font-size:.82rem;color:var(--ink)}
.series-toggle-sub{font-size:.68rem;color:var(--dim);display:block;margin-top:.15rem}
.series-toggle.active{border-color:var(--acc);background:rgba(229,193,90,.05)}
@media(max-width:480px){h1{font-size:1.8rem}.images-grid{grid-template-columns:repeat(auto-fill,minmax(80px,1fr))}.phase-step{font-size:.48rem;padding:.35rem .2rem}body{padding-bottom:22rem}.debug-panel{height:220px}}
</style>
