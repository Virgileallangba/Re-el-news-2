    s.segment_number=i+1;
    if(!s.reporter)s.reporter={name:'Reporter',description:'grey trench coat',dialogue:''};
    if(!s.host_action)s.host_action=jt.host.host_action;
    if(!s.scene_action)s.scene_action='the reporter and people perform a choreography while smoke fills the frame';
    if(!s.camera_plan)s.camera_plan='Opening wide, close-ups, shot-reverse-shot, final wide symmetrical frame.';
    if(!s.people||!Array.isArray(s.people)||s.people.length===0){
      s.people=[
        {name:'Figurant 1',description:'outfit matching the news',role:'witness',stanislavski:{objective:'to be seen',obstacle:'anonymity',given_circumstances:'ordinary person',physical_action:'waves nervously'}},
