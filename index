/* ═══════════════════════════════════════════════════════════
   QUEUE RATE-LIMITED
   ═══════════════════════════════════════════════════════════ */
function createRateLimitedQueue(maxConcurrent,minIntervalMs){
  let running=0;
  let lastStart=0;
  const queue=[];
  let resolveIdle=null;
  function tryNext(){
    if(running>=maxConcurrent)return;
    if(queue.length===0){
      if(running===0&&resolveIdle){resolveIdle();resolveIdle=null}
      return;
    }
    const now=Date.now();
    const wait=Math.max(0,lastStart+minIntervalMs-now);
    if(wait>0){setTimeout(tryNext,wait);return}
    const task=queue.shift();
    running++;
    lastStart=Date.now();
    task().finally(()=>{running--;setTimeout(tryNext,0)});
  }
  return{
    add(fn){return new Promise((resolve,reject)=>{queue.push(()=>fn().then(resolve,reject));setTimeout(tryNext,0)})},
    idle(){return new Promise(r=>{if(running===0&&queue.length===0)return r();resolveIdle=r})}
  };
}

