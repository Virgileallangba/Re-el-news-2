function readFileAsDataURL(file){
  return new Promise((resolve,reject)=>{
    const reader=new FileReader();
    reader.onload=()=>resolve(reader.result);
    reader.onerror=()=>reject(new Error('Lecture impossible'));
    reader.readAsDataURL(file);
  });
}
async function addReferenceImages(files){
  const remaining=REF_MAX_IMAGES-state.referenceImages.length;
  if(remaining<=0){showToast('Maximum '+REF_MAX_IMAGES+' images atteint','warn');return}
  const toAdd=Array.from(files).slice(0,remaining);
  for(const file of toAdd){
    if(!file.type.startsWith('image/')){showToast('Format non supporté : '+file.name,'error');continue}
    if(file.size>REF_MAX_SIZE){showToast('Image trop lourde (max 3 Mo) : '+file.name,'error');continue}
    try{
      const dataUrl=await readFileAsDataURL(file);
      const compressed=await compressImage(dataUrl,900,0.82);
      state.referenceImages.push({
        id:'ref-'+Date.now()+'-'+Math.random().toString(36).slice(2,7),
        dataUrl:compressed,name:file.name,description:'',role:'auto'
      });
      debugLog('success','REF','Image ajoutée : '+file.name+' ('+Math.round(compressed.length/1024)+' Ko)');
    }catch(e){showToast('Erreur : '+e.message,'error')}
  }
  renderRefGallery();
  updateJTButton();
}
function compressImage(dataUrl,maxSize,quality){
  return new Promise((resolve)=>{
    const img=new Image();
    img.onload=()=>{
      let w=img.width,h=img.height;
      if(w>maxSize||h>maxSize){
        const ratio=Math.min(maxSize/w,maxSize/h);
        w=Math.round(w*ratio);h=Math.round(h*ratio);
      }
      const c=document.createElement('canvas');
      c.width=w;c.height=h;
      const ctx=c.getContext('2d');
      ctx.drawImage(img,0,0,w,h);
      try{resolve(c.toDataURL('image/jpeg',quality))}catch(e){resolve(dataUrl)}
    };
    img.onerror=()=>resolve(dataUrl);
    img.src=dataUrl;
  });
}
function removeReferenceImage(id){
