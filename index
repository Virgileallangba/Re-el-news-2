function setStatus(text){
  const bar=document.getElementById('status-bar');
  const txt=document.getElementById('status-text');
  if(!bar||!txt)return;
  if(text){
    bar.classList.add('visible');
    txt.textContent=text;
    if(/saturée|indisponible|abandon/i.test(text)){
      bar.style.borderTopColor='var(--err)';bar.style.borderTopWidth='2px';
    }else if(/attente|reprise|nouvelle tentative/i.test(text)){
      bar.style.borderTopColor='var(--warn)';bar.style.borderTopWidth='2px';
    }else{
      bar.style.borderTopColor='';bar.style.borderTopWidth='';
    }
  }else{
    bar.classList.remove('visible');
    bar.style.borderTopColor='';bar.style.borderTopWidth='';
  }
}
function setPhase(phase,detail,eta){
  const bar=document.getElementById('phase-bar');
  if(bar)bar.classList.add('visible');
  document.querySelectorAll('.phase-step').forEach(el=>{
    el.classList.remove('active','done');
    const order=['text','dialogue','images','videos','done'];
    const curIdx=order.indexOf(phase);
    const elIdx=order.indexOf(el.dataset.phase);
    if(elIdx<curIdx)el.classList.add('done');
    else if(elIdx===curIdx)el.classList.add('active');
  });
  const d=document.getElementById('phase-detail');
  const e=document.getElementById('phase-eta');
  if(d)d.innerHTML=detail||'';
  if(e)e.textContent=eta||'';
}

