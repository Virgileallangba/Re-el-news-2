function saveApiKey(){
  const btn=document.getElementById('api-save-btn');
  const input=document.getElementById('api-key-input');
  const statusText=document.getElementById('api-status-text');
  if(btn){btn.textContent='⏳ Traitement…';btn.disabled=true;}
  try{
    if(!input){
      if(statusText)statusText.textContent='Erreur : champ introuvable';
      if(btn){btn.textContent='✕ Erreur';setTimeout(()=>{btn.textContent='Enregistrer la clé';btn.disabled=false},2000);}
      return;
    }
    const key=input.value.trim();
    if(!key){
      memoryApiKey='';
      if(storageAvailable){try{localStorage.removeItem(API_KEY_STORAGE)}catch(e){storageAvailable=false}}
      updateApiPanel();
      showToast('Clé supprimée','warn');
      if(btn){btn.textContent='✓ Supprimé';setTimeout(()=>{btn.textContent='Enregistrer la clé';btn.disabled=false},1500);}
      return;
    }
    memoryApiKey=key;
    let persisted=false;
    if(storageAvailable){
      try{
        localStorage.setItem(API_KEY_STORAGE,key);
        const check=(localStorage.getItem(API_KEY_STORAGE)||'').trim();
        persisted=(check===key);
        if(!persisted)storageAvailable=false;
      }catch(e){storageAvailable=false}
    }
    updateApiPanel();
    if(persisted){
      showToast('Clé enregistrée ✓','success');
      if(btn)btn.textContent='✓ Enregistré';
    }else{
      showToast('Clé active (session uniquement)','warn',3500);
      if(btn)btn.textContent='✓ Actif (session)';
    }
    input.blur();
    setTimeout(()=>{if(btn){btn.textContent='Enregistrer la clé';btn.disabled=false;}},2200);
  }catch(err){
    console.error('[saveApiKey] EXCEPTION :',err);
    showToast('Erreur : '+err.message,'error',5000);
    if(statusText)statusText.textContent='Erreur : '+err.message;
    if(btn){btn.textContent='✕ Erreur';setTimeout(()=>{btn.textContent='Enregistrer la clé';btn.disabled=false;},2500);}
  }
}

function updateApiPanel(){
  const panel=document.getElementById('api-panel');
  const input=document.getElementById('api-key-input');
  const statusLine=document.getElementById('api-status-line');
  const statusText=document.getElementById('api-status-text');
  if(!panel||!input||!statusLine||!statusText)return;
  const key=getApiKey();
  if(key){
    panel.classList.add('ok');
    statusLine.classList.add('ok');
    statusLine.classList.remove('warn');
    const mode=storageAvailable?'persistante':'session';
    statusText.textContent='Clé active ('+mode+') · '+key.slice(0,8)+'…'+key.slice(-4);
