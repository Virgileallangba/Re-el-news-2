        const intro = SERIES.introLine;
        if(!s.host_dialogue || !s.host_dialogue.startsWith(intro.slice(0,20))){
          s.host_dialogue = intro + (s.host_dialogue ? ' ' + s.host_dialogue : '');
        }
      }
      if(i===jt.segments.length-1){
        // Force la phrase d'outro à la fin du dernier segment
        s.host_dialogue = (s.host_dialogue || '') + ' ' + SERIES.outroLine;
      }
    }

    let hw=countWords(s.host_dialogue);
    if(hw>28)s.host_dialogue=s.host_dialogue.trim().split(/\s+/).slice(0,26).join(' ');
    if(hw>0&&hw<6)s.host_dialogue=s.host_dialogue+' aujourd\'hui.';
    let rw=countWords(s.reporter.dialogue);
    if(rw>22)s.reporter.dialogue=s.reporter.dialogue.trim().split(/\s+/).slice(0,18).join(' ');
