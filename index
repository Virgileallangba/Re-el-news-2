    if(!s.reporter.dialogue||s.reporter.dialogue===s.host_dialogue)s.reporter.dialogue='Même ma machine à café aurait demandé une mutation.';

    const retro='retro-futuristic funny costume with oversized geometric details, chrome accessories, absurd gadget';
    if(s.reporter.description&&!/retro|futur/i.test(s.reporter.description))s.reporter.description+='; '+retro;
