  if(state.seriesMode && SERIES.enabled){
    const staniOriginal = (jt.host && jt.host.stanislavski) || {};
    jt.host = {
      name: SERIES.hostFixed.name,
      description: SERIES.hostFixed.description,
      plateau: SERIES.hostFixed.plateau,
      host_action: SERIES.hostFixed.host_action,
      stanislavski: {
        objective: staniOriginal.objective || 'deliver the news with absolute composure',
        obstacle: staniOriginal.obstacle || 'the studio is actively falling apart around him',
        given_circumstances: staniOriginal.given_circumstances || '20 years anchoring the 19h59 slot, exhausted but professional',
        physical_action: staniOriginal.physical_action || 'adjusts his spinning bow tie every time something breaks'
      }
    };
    debugLog('success','SÉRIE','Roger Blip forcé comme chroniqueur fixe');
  }else{
    if(!jt.host)jt.host={name:'Chroniqueur',description:'silver-haired anchor, grey suit, oversized round glasses',plateau:'TV studio, symmetrical',host_action:'the host presses a giant chrome button and the studio rotates',stanislavski:{objective:'deliver the news',obstacle:'the studio falls apart',given_circumstances:'20 years anchoring',physical_action:'presses button slowly'}};
    if(!jt.host.host_action)jt.host.host_action='the host turns a giant chrome crank and the studio walls split open';
  }

  if(jt.segments.length<segCount){const last=jt.segments[jt.segments.length-1];while(jt.segments.length<segCount){jt.segments.push(JSON.parse(JSON.stringify(last)));jt.segments[jt.segments.length-1].segment_number=jt.segments.length}}
  if(jt.segments.length>segCount)jt.segments=jt.segments.slice(0,segCount);

  jt.segments.forEach((s,i)=>{
