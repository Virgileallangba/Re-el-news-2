    (s.people||[]).forEach(p=>{
      if(!p.description)p.description='news-related '+retro;
      if(!/retro|futur/i.test(p.description))p.description+='; '+retro;
    });
  });

  debugLog('success','JT',jt.segments.length+' segments créés'+(state.seriesMode?' (mode série)':''));
  return jt;
}

