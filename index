/* ═══════════════════════════════════════════════════════════
   API FETCH avec retry / backoff
   ═══════════════════════════════════════════════════════════ */
async function apiFetch(url,options={},label='API',kind='default'){
  const maxAttempts=kind==='video'?10:kind==='image'?10:8;
  for(let attempt=0;attempt<maxAttempts;attempt++){
    if(state.stopRequested)throw new Error('Arrêt demandé');
    const method=options.method||'GET';
    let bodyPreview=null;
    if(options.body){
      try{
        const p=JSON.parse(options.body);
        const c=JSON.parse(JSON.stringify(p));
        if(c.image&&typeof c.image==='string'&&c.image.length>80)c.image=c.image.slice(0,80)+'…[b64 '+c.image.length+']';
        if(c.last_frame&&typeof c.last_frame==='string'&&c.last_frame.length>80)c.last_frame=c.last_frame.slice(0,80)+'…[b64 '+c.last_frame.length+']';
        if(c.messages&&Array.isArray(c.messages)){
          c.messages=c.messages.map(m=>{
            if(Array.isArray(m.content)){
              return{...m,content:m.content.map(part=>{
                if(part.type==='image_url'&&part.image_url&&typeof part.image_url.url==='string'&&part.image_url.url.length>80){
                  return{...part,image_url:{url:part.image_url.url.slice(0,80)+'…[b64]'}};
                }
                return part;
              })};
            }
            return m;
          });
        }
        bodyPreview=c;
      }catch(e){bodyPreview=String(options.body).slice(0,500)}
    }
    debugLog('api','REQ '+label,method+' '+url+' (tentative '+(attempt+1)+'/'+maxAttempts+')',bodyPreview);
    try{
      const t0=Date.now();
      const res=await fetch(url,options);
      const dt=Date.now()-t0;
      let retryAfter=0;
      try{retryAfter=parseInt(res.headers.get('Retry-After')||'0',10)||0}catch(e){}
      let errorText='';
      if(!res.ok&&([400,401,404,429,500,502,503,504,520].includes(res.status)||kind==='video')){
        try{errorText=(await res.clone().text()).slice(0,1200)}catch(e){}
      }
      debugLog('response','RÉP '+label,'HTTP '+res.status+' en '+dt+'ms',errorText||undefined);
      if(res.ok){
        if(kind==='image'){imageAttemptsSinceLastError++;if(imageAttemptsSinceLastError>=4&&createImageIntervalMs>IMAGE_INTERVAL_MIN){createImageIntervalMs=Math.max(IMAGE_INTERVAL_MIN,createImageIntervalMs-250);imageAttemptsSinceLastError=0}}
        if(kind==='video'){videoAttemptsSinceLastError++;if(videoAttemptsSinceLastError>=2&&createVideoIntervalMs>VIDEO_INTERVAL_MIN){createVideoIntervalMs=Math.max(VIDEO_INTERVAL_MIN,createVideoIntervalMs-3000);videoAttemptsSinceLastError=0}}
        return res;
      }
      if([400,401,404].includes(res.status)&&kind!=='video'){throw new Error('HTTP '+res.status+' — '+errorText.slice(0,300))}
      const queueFull=/video_queue_full|queue is full|queue_full/i.test(errorText);
      if(kind==='video'&&queueFull){
        videoAttemptsSinceLastError=0;
        const baseWait=retryAfter>0?retryAfter:Math.min(480,60*Math.pow(2,attempt));
        const jitter=Math.floor(Math.random()*15);
        const wait=baseWait+jitter;
        debugLog('warn','VIDEO_QUEUE','Queue saturée (tentative '+(attempt+1)+'/10) — attente '+wait+'s');
        setStatus('File vidéo Agnes saturée — reprise dans '+wait+'s (essai '+(attempt+1)+'/10)');
        if(attempt>=5)throw new Error('Queue vidéo saturée en continu après '+attempt+' tentatives — abandon. Réessayez dans 30 min.');
        await sleep(wait*1000);
        continue;
      }
      if(res.status===429){
        const wait=retryAfter>0?retryAfter:Math.min(kind==='video'?180:120,kind==='video'?60+attempt*8:10+attempt*12);
        if(kind==='image')createImageIntervalMs=Math.min(IMAGE_INTERVAL_MAX,createImageIntervalMs+1000);
        if(kind==='video')createVideoIntervalMs=Math.min(VIDEO_INTERVAL_MAX,createVideoIntervalMs+6000);
        debugLog('warn','RATELIMIT','429 — attente '+wait+'s');
        setStatus('Limite API — nouvelle tentative dans '+wait+'s');
        await sleep(wait*1000);
        continue;
      }
      if([500,502,503,504,520].includes(res.status)){
        const isImmediateReject=dt<2000;
        if(res.status===503&&kind==='video'&&isImmediateReject){
          const wait=Math.min(480,60*Math.pow(2,attempt));
          debugLog('warn','SERVICE','503 immédiat — attente '+wait+'s');
          setStatus('File vidéo saturée — attente '+wait+'s (essai '+(attempt+1)+'/10)');
          if(attempt>=5)throw new Error('Service vidéo indisponible (503 persistant) — réessayez plus tard.');
          await sleep(wait*1000);
          continue;
        }
        const wait=Math.min(kind==='video'?180:60,kind==='video'?20+attempt*10:5+attempt*5);
        debugLog('warn','SERVICE','HTTP '+res.status+' — attente '+wait+'s');
        setStatus('Service occupé — nouvelle tentative dans '+wait+'s');
        await sleep(wait*1000);
        continue;
      }
      return res;
    }catch(e){
      if(e.message==='Arrêt demandé')throw e;
      if(/abandon|indisponible|saturée en continu/i.test(e.message))throw e;
      const wait=Math.min(kind==='video'?120:45,kind==='video'?10+attempt*8:3+attempt*4);
      debugLog('warn','NETWORK',e.message+' — retry dans '+wait+'s');
      setStatus('Connexion instable — reprise dans '+wait+'s');
      await sleep(wait*1000);
    }
  }
  throw new Error('Tentatives épuisées pour '+label+' après '+maxAttempts+' essais');
}

/* ═══════════════════════════════════════════════════════════
   PARSING JSON ROBUSTE
   ═══════════════════════════════════════════════════════════ */
function escapeControlCharsInStrings(text){
  let result='';let inString=false;let escape=false;
  for(let i=0;i<text.length;i++){
    const ch=text[i];
    if(escape){result+=ch;escape=false;continue}
    if(ch==='\\'){result+=ch;escape=true;continue}
    if(ch==='"'){inString=!inString;result+=ch;continue}
    if(inString){
      if(ch==='\n'){result+='\\n';continue}
      if(ch==='\r'){result+='\\r';continue}
      if(ch==='\t'){result+='\\t';continue}
      const code=ch.charCodeAt(0);
      if(code<32){result+='\\u'+code.toString(16).padStart(4,'0');continue}
    }
    result+=ch;
  }
  return result;
}
function balanceJson(text){
  let openBraces=0,openBrackets=0,inString=false,escape=false;
  for(let i=0;i<text.length;i++){
    const ch=text[i];
    if(escape){escape=false;continue}
    if(ch==='\\'){escape=true;continue}
    if(ch==='"'){inString=!inString;continue}
    if(inString)continue;
    if(ch==='{')openBraces++;
    else if(ch==='}')openBraces--;
    else if(ch==='[')openBrackets++;
    else if(ch===']')openBrackets--;
  }
  let result=text;
  if(inString)result+='"';
  while(openBrackets>0){result+=']';openBrackets--}
  while(openBraces>0){result+='}';openBraces--}
  return result;
}
function salvageScenario(text){
  const grab=(str,key)=>{
    const re=new RegExp('"'+key+'"\\s*:\\s*"((?:[^"\\\\]|\\\\.)*)"');
    const m=str.match(re);
    return m?m[1].replace(/\\n/g,' ').replace(/\\r/g,' ').replace(/\\t/g,' ').replace(/\\"/g,'"').replace(/\\\\/g,'\\'):null;
  };
  const titleMatch=grab(text,'jt_title')||grab(text,'title');
  const segSplit=text.split(/"segment_number"\s*:\s*\d+/);
  const segments=[];
  for(let k=1;k<segSplit.length;k++){
    const block=segSplit[k];
    const headline=grab(block,'headline');
    const summary=grab(block,'summary');
    const host_dialogue=grab(block,'host_dialogue');
    const host_action=grab(block,'host_action');
    const location=grab(block,'location');
    const scene_action=grab(block,'scene_action');
    const camera_plan=grab(block,'camera_plan');
    const emotion=grab(block,'emotion')||'spectaculaire';
    if(!headline||!summary)continue;
    const repIdx=block.lastIndexOf('"reporter"');
    const repBlock=repIdx>=0?block.slice(repIdx):'';
    const reporterName=grab(repBlock,'name');
    const reporterDesc=grab(repBlock,'description');
    const reporterDialogue=grab(repBlock,'dialogue');
    const people=[];
    const peopleIdx=block.indexOf('"people"');
    const peopleEnd=repIdx>=0?repIdx:block.length;
    const peopleBlock=peopleIdx>=0?block.slice(peopleIdx,peopleEnd):'';
    const pRegex=/\{\s*"name"\s*:\s*"((?:[^"\\]|\\.)*)"[\s\S]*?"description"\s*:\s*"((?:[^"\\]|\\.)*)"[\s\S]*?"role"\s*:\s*"((?:[^"\\]|\\.)*)"/g;
    let pm;
    while((pm=pRegex.exec(peopleBlock))!==null){
      people.push({name:pm[1].replace(/\\"/g,'"'),description:pm[2].replace(/\\"/g,'"'),role:pm[3].replace(/\\"/g,'"')});
    }
    segments.push({
      segment_number:segments.length+1,
      headline,summary,
      host_dialogue:host_dialogue||'',host_action:host_action||'',
      people,location:location||'',
      scene_action:scene_action||'',camera_plan:camera_plan||'',
      reporter:{name:reporterName||'Reporter',description:reporterDesc||'',dialogue:reporterDialogue||''},
      emotion
    });
  }
  const hostHeader=segSplit[0]||'';
  const hostIdx=hostHeader.indexOf('"host"');
  const hostBlock=hostIdx>=0?hostHeader.slice(hostIdx):hostHeader;
  const host={
    name:grab(hostBlock,'name')||'Chroniqueur',
    description:grab(hostBlock,'description')||'',
    plateau:grab(hostBlock,'plateau')||'',
    host_action:grab(hostBlock,'host_action')||''
  };
  if(segments.length===0)return null;
  return{jt_title:titleMatch||'Le JT de NewsReel',host,segments};
}
function extractJson(text){
  if(!text)return null;
  let c=text.trim();
  const fm=c.match(/```(?:json)?\s*([\s\S]*?)```/);
  if(fm)c=fm[1].trim();
  const fb=c.indexOf('{');
  if(fb<0){debugLog('error','PARSE','Aucun { trouvé');return null}
  c=c.slice(fb);
  try{const r=JSON.parse(c);debugLog('success','PARSE','Stratégie 1 OK');return r}catch(e1){debugLog('warn','PARSE','S1 échouée')}
  try{const r=JSON.parse(escapeControlCharsInStrings(c));debugLog('success','PARSE','Stratégie 2 OK');return r}catch(e2){debugLog('warn','PARSE','S2 échouée')}
  try{const lb=c.lastIndexOf('}');if(lb>0){const r=JSON.parse(escapeControlCharsInStrings(c.slice(0,lb+1)));debugLog('success','PARSE','Stratégie 3 OK');return r}}catch(e3){debugLog('warn','PARSE','S3 échouée')}
  try{const r=JSON.parse(balanceJson(escapeControlCharsInStrings(c)));debugLog('success','PARSE','Stratégie 4 OK');return r}catch(e4){debugLog('warn','PARSE','S4 échouée')}
  try{const s=salvageScenario(c);if(s&&s.segments&&s.segments.length>0){debugLog('success','PARSE','Stratégie 5 (regex) — '+s.segments.length+' segments');return s}}catch(e5){debugLog('error','PARSE','S5 échouée')}
  debugLog('error','PARSE','Aucune stratégie n\'a fonctionné');
  return null;
}

